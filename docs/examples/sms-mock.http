POST {{budingyun_url}}/Api/Sent
Accept: application/json;charset=utf-8
Content-Type: application/x-www-form-urlencoded

key={{budingyun_key}}&to={{phone}}&content={{bd_content}}&sign={{budingyun_sign}}

