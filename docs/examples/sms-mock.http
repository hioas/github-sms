# =====================================================================================================================
# 15. 极光（jg）— HTTP Basic Auth(appKey:masterSecret)
#     成功判定: $.msg_id != null（单发）/ $.success_count != null（批量）
# =====================================================================================================================

### 极光 - 单条模板短信
< {%
request.variables.set("jg_auth", "Basic " + btoa(request.environment.get("jg_app_key") + ":" + request.environment.get("jg_master_secret")));
%}

POST {{jg_url}}messages
Accept: application/json
Content-Type: application/json;charset=utf-8
Authorization: {{jg_auth}}

{
  "mobile": "{{phone}}",
  "sign_id": "{{jg_sign_id}}",
  "temp_id": "{{jg_tpl_id}}",
  "temp_para": { "code": "{{code}}" }
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("jg msg_id != null", function() {
    client.assert(response.body.msg_id != null, "msg_id is null, actual: " + JSON.stringify(response.body));
});
%}

### 极光 - 批量模板短信（号码补 +86）
< {%
request.variables.set("jg_auth2", "Basic " + btoa(request.environment.get("jg_app_key") + ":" + request.environment.get("jg_master_secret")));
%}

POST {{jg_url}}messages/batch
Accept: application/json
Content-Type: application/json;charset=utf-8
Authorization: {{jg_auth2}}

{
  "sign_id": "{{jg_sign_id}}",
  "temp_id": "{{jg_tpl_id}}",
  "recipients": [
    { "mobile": "+86{{phone}}", "temp_para": { "code": "{{code}}" } },
    { "mobile": "+86{{phone2}}", "temp_para": { "code": "{{code}}" } }
  ]
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("jg success_count != null", function() {
    client.assert(response.body.success_count != null, "success_count is null, actual: " + JSON.stringify(response.body));
});
%}


# =====================================================================================================================
# 16. 联通一信通（yixintong）— GBK 表单、20 位流水号；响应为文本（含 result=0& 即成功）
#     注意：引擎按 GBK 编码表单（body.charset=gbk）；HTTP Client 以 UTF-8 发送，精确编码以引擎为准。
# =====================================================================================================================

### 一信通 - 发送（20 位流水号由脚本生成）
< {%
request.variables.set("yxt_serial", Date.now().toString() + ("0000000" + Math.floor(Math.random() * 1e7)).slice(-7));
request.variables.set("yxt_msg", encodeURIComponent("【您的签名】验证码：" + request.environment.get("code") + "，请勿泄露。"));
%}

POST {{yixintong_url}}
Content-Type: application/x-www-form-urlencoded; charset=gbk

SpCode={{yixintong_sp_code}}&LoginName={{yixintong_login}}&Password={{yixintong_password}}&MessageContent={{yxt_msg}}&UserNumber={{phone}}&templateId={{yixintong_tpl_id}}&SerialNumber={{yxt_serial}}&ScheduleTime=&f=1&signCode={{yixintong_sign_code}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("yixintong result=0& in body", function() {
    client.assert(response.body.includes("result=0&"), "no 'result=0&' in body, actual: " + JSON.stringify(response.body));
});
%}


