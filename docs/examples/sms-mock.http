# 14. 螺丝帽（luosimao）— Basic Auth（user=api, pwd=key-密钥）
#     成功判定: $.error == 0
# =====================================================================================================================

### 螺丝帽 - 发送
< {%
request.variables.set("ls_auth", "Basic " + btoa("api:key-" + request.environment.get("luosimao_key")));
request.variables.set("ls_msg", encodeURIComponent("【您的签名】验证码：" + request.environment.get("code") + "，请勿泄露。"));
%}

POST {{luosimao_host}}send.json
Content-Type: application/x-www-form-urlencoded
Authorization: {{ls_auth}}

mobile={{phone}}&message={{ls_msg}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("luosimao error == 0", function() {
    client.assert(response.body.error === 0, "error not 0, actual: " + JSON.stringify(response.body));
});
%}

### 螺丝帽 - 余额查询
< {%
request.variables.set("ls_auth2", "Basic " + btoa("api:key-" + request.environment.get("luosimao_key")));
%}

GET {{luosimao_host}}status.json
Authorization: {{ls_auth2}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
