# =====================================================================================================================
# 18. 旦米（danmi）— sig 占位（真实为 MD5(accountSid + authToken + 毫秒时间戳)）
#     成功判定: $.respCode == '00000'
# =====================================================================================================================

### 旦米 - 短信发送
< {%
request.variables.set("dm_ts", "1234567890");
request.variables.set("dm_sig", "mock-signature");
request.variables.set("dm_content", encodeURIComponent("【您的签名】验证码：" + request.environment.get("code") + "，请勿泄露。"));
%}

POST {{danmi_host}}distributor/sendSMS
Content-Type: application/json

{
  "respDataType": "JSON",
  "accountSid": "{{danmi_sid}}",
  "templateid": "{{danmi_tpl_id}}",
  "smsContent": "{{dm_content}}",
  "to": ["+86{{phone}}"],
  "timestamp": "{{dm_ts}}",
  "sig": "{{dm_sig}}"
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("danmi respCode == '00000'", function() {
    client.assert(response.body.respCode === "00000", "respCode not 00000, actual: " + JSON.stringify(response.body));
});
%}


