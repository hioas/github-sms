# =====================================================================================================================
# sms-mock.http — hioas-sms 19 个渠道的本地 Mock 联调用例（IntelliJ IDEA HTTP Client 格式）
# =====================================================================================================================
# 与 sms.http 的区别：
#   * sms.http 面向真实厂商接口，需要真实凭证才能跑通；
#   * 本文件把所有渠道 URL 指向本地 mock 服务器（src/test/java/.../mock/MockVendorServer.java），
#     无需任何真实凭证，选择 mock 环境后即可在 IDEA 中逐条点击测试。
# 用法：
#   1. 启动 mock 服务器：
#        - 打开 src/test/java/com/hioas/sms/mock/MockVendorServer.java，右键 Run main()；
#        - 或命令行：mvn test-compile && java -cp target/classes:target/test-classes com.hioas.sms.mock.MockVendorServer
#      默认监听 http://localhost:18080。
#   2. IDE 右上角 HTTP Client 环境选择 mock（定义在 http-client.env.json，全部为本地地址+假凭证）。
#   3. 点击每个请求左侧 ▶ 发送；每个请求下方都带有 > {% client.test(...) %} 断言块，
#      成功 ✅ / 失败 ❌ 直接显示在请求旁。
#   4. mock 服务器会校验各渠道的必填字段：缺失时返回 400 + {"mockError": ...}，对应断言变红，
#      便于定位「请求形态」问题。未知路径返回 404。
#   5. 所有签名/时间戳变量均由简化脚本填占位值（mock 不校验签名，只校验字段是否齐全）。
# 请求与 src/main/resources/channels/<channel>.api.json 一一对应；断言即各渠道 response.successWhen。
# =====================================================================================================================


# =====================================================================================================================
# 1. 创蓝（chuanglan）— 明文账号密码、JSON body，无签名
#    成功判定: $.code == '0'
# =====================================================================================================================

### 创蓝 - 单发（params = 手机号,内容）
POST {{chuanglan_base_url}}{{chuanglan_msg_url}}
Content-Type: application/json

{
  "account": "{{chuanglan_account}}",
  "password": "{{chuanglan_password}}",
  "msg": "{{chuanglan_msg}}",
  "params": "{{phone}},{{code}}"
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("chuanglan code == '0'", function() {
    client.assert(response.body.code === "0", "code not '0', actual: " + JSON.stringify(response.body));
});
%}

### 创蓝 - 群发（params = 手机号,内容;手机号,内容）
POST {{chuanglan_base_url}}{{chuanglan_msg_url}}
Content-Type: application/json

{
  "account": "{{chuanglan_account}}",
  "password": "{{chuanglan_password}}",
  "msg": "{{chuanglan_msg}}",
  "params": "{{phone}},{{code}};{{phone2}},{{code}}"
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("chuanglan code == '0'", function() {
    client.assert(response.body.code === "0", "code not '0', actual: " + JSON.stringify(response.body));
});
%}


# =====================================================================================================================
# 2. 助通（zhutong）— 签名占位（真实为 md5(md5(密码)+tKey)）
#    成功判定: $.code <= 200
# =====================================================================================================================

### 助通 - 模板短信（v2/sendSmsTp，逐号码 records）
< {%
request.variables.set("zt_tkey", "1234567890");
request.variables.set("zt_pwd", "mock-" + request.environment.get("zhutong_password"));
%}

POST {{zhutong_base_url}}v2/sendSmsTp
Content-Type: application/json;charset=utf-8

{
  "username": "{{zhutong_username}}",
  "tKey": "{{zt_tkey}}",
  "password": "{{zt_pwd}}",
  "tpId": "{{zhutong_tpl_id}}",
  "signature": "{{zhutong_signature}}",
  "ext": "",
  "extend": "",
  "records": [
    { "mobile": "{{phone}}", "tpContent": { "code": "{{code}}" } }
  ]
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("zhutong code == 200", function() {
    client.assert(response.body.code === 200, "code not 200, actual: " + JSON.stringify(response.body));
});
%}

### 助通 - 自定义短信（v2/sendSms，内容必须自带【签名】）
< {%
request.variables.set("zt_tkey2", "1234567891");
request.variables.set("zt_pwd2", "mock-" + request.environment.get("zhutong_password"));
%}

POST {{zhutong_base_url}}v2/sendSms
Content-Type: application/json;charset=utf-8

{
  "username": "{{zhutong_username}}",
  "password": "{{zt_pwd2}}",
  "tKey": "{{zt_tkey2}}",
  "mobile": "{{phone}},{{phone2}}",
  "content": "【{{zhutong_signature}}】您的验证码是{{code}}，5分钟内有效。"
}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("zhutong code == 200", function() {
    client.assert(response.body.code === 200, "code not 200, actual: " + JSON.stringify(response.body));
});
%}


# =====================================================================================================================
# 3. 阿里云（aliyun）— 签名占位（真实为 POP v1 HMAC-SHA1）；路径 "/"，无 X-TC-Action 头即命中 mock 的 aliyun 路由
#    成功判定: $.Code == 'OK'
# =====================================================================================================================

### 阿里云 - SendSms（POP v1 签名）
< {%
// 占位：真实请求中 Signature 由 HMAC-SHA1(secret+"&", StringToSign) 计算
request.variables.set("ali_sig", "mock-signature");
request.variables.set("ali_query",
  "Action=SendSms&Format=JSON&SignatureMethod=HMAC-SHA1&SignatureVersion=1.0&SignatureNonce=mock-nonce"
  + "&Version=2017-05-25&Timestamp=2026-08-31T12%3A00%3A00Z&RegionId=cn-hangzhou"
  + "&AccessKeyId=" + request.environment.get("aliyun_ak"));
request.variables.set("ali_body",
  "PhoneNumbers=" + request.environment.get("phone")
  + "&SignName=" + encodeURIComponent(request.environment.get("aliyun_sign"))
  + "&TemplateParam=" + encodeURIComponent(JSON.stringify({code: request.environment.get("code")}))
  + "&TemplateCode=" + request.environment.get("aliyun_tpl_code"));
%}

POST http://{{aliyun_host}}/?Signature={{ali_sig}}&{{ali_query}}
Content-Type: application/x-www-form-urlencoded

{{ali_body}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("aliyun Code == 'OK'", function() {
    client.assert(response.body.Code === "OK", "Code not OK, actual: " + JSON.stringify(response.body));
});
%}


# =====================================================================================================================
# 4. 腾讯云（tencent）— 签名占位（真实为 TC3-HMAC-SHA256）；路径 "/"，X-TC-Action: SendSms 头命中 mock 的 tencent 路由
#    成功判定: $.Response.SendStatusSet[0].Code == 'Ok'
# =====================================================================================================================

### 腾讯云 - SendSms（TC3 签名）
< {%
// 占位：真实请求中 Authorization 由 TC3-HMAC-SHA256 四步密钥派生计算
request.variables.set("tc_body", JSON.stringify({
  PhoneNumberSet: ["+86" + request.environment.get("phone") + ""],
  SmsSdkAppId: "" + request.environment.get("tencent_sdk_app_id") + "",
  SignName: "" + request.environment.get("tencent_sign") + "",
  TemplateId: "" + request.environment.get("tencent_tpl_id") + "",
  TemplateParamSet: ["" + request.environment.get("code") + ""]
}));
request.variables.set("tc_ts", "1234567890");
request.variables.set("tc_auth",
  "TC3-HMAC-SHA256 Credential=" + request.environment.get("tencent_ak")
  + "/2026-08-31/sms/tc3_request, SignedHeaders=content-type;host, Signature=mock-signature");
%}

POST http://{{tencent_host}}
Authorization: {{tc_auth}}
Content-Type: application/json; charset=utf-8
Host: {{tencent_host}}
X-TC-Action: SendSms
X-TC-Timestamp: {{tc_ts}}
X-TC-Version: 2021-01-11
X-TC-Region: ap-guangzhou

{{tc_body}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("tencent SendStatusSet[0].Code == 'Ok'", function() {
    client.assert(response.body.Response.SendStatusSet[0].Code === "Ok",
        "Code not Ok, actual: " + JSON.stringify(response.body));
});
%}


