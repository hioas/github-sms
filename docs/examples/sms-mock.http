# =====================================================================================================================
# 8. 中国移动云MAS（mas）— 整体 JSON Base64 后作为请求体（mac 为占位；真实为 MD5 拼接）
#    成功判定: $.rspcod == 'success' && $.success == true
# =====================================================================================================================

### 云MAS - 模板短信（tmpsubmit，body = Base64(JSON)）
< {%
const payload = JSON.stringify({
  ecName: request.environment.get("mas_ec_name"),
  apId: request.environment.get("mas_ap_id"),
  secretKey: request.environment.get("mas_secret"),
  templateId: request.environment.get("mas_tpl_id"),
  mobiles: request.environment.get("phone"),
  params: JSON.stringify([request.environment.get("code")]),
  sign: request.environment.get("mas_sign"),
  addSerial: request.environment.get("mas_add_serial"),
  mac: "mock-mas-mac"
});
// UTF-8 → Base64：等价于 btoa(unescape(encodeURIComponent(...)))，但不依赖非标准 escape/unescape（GraalJS 未提供）
function utf8(s){return encodeURIComponent(s).replace(/%([0-9A-F]{2})/g,function(m,p){return String.fromCharCode(parseInt(p,16))})}
request.variables.set("mas_body", btoa(utf8(payload)));
%}

POST {{mas_url}}tmpsubmit
Content-Type: application/json

{{mas_body}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("mas rspcod == 'success' && success == true", function() {
    client.assert(response.body.rspcod === "success", "rspcod not success, actual: " + JSON.stringify(response.body));
    client.assert(response.body.success === true, "success not true, actual: " + JSON.stringify(response.body));
});
%}

### 云MAS - 自定义短信（norsubmit，body = Base64(JSON)）
< {%
const payload = JSON.stringify({
  ecName: request.environment.get("mas_ec_name"),
  apId: request.environment.get("mas_ap_id"),
  secretKey: request.environment.get("mas_secret"),
  mobiles: request.environment.get("phone"),
  content: "【" + request.environment.get("mas_sign") + "】您的验证码是" + request.environment.get("code") + "，请勿泄露。",
  sign: request.environment.get("mas_sign"),
  addSerial: request.environment.get("mas_add_serial"),
  mac: "mock-mas-mac"
});
function utf8(s){return encodeURIComponent(s).replace(/%([0-9A-F]{2})/g,function(m,p){return String.fromCharCode(parseInt(p,16))})}
request.variables.set("mas_body2", btoa(utf8(payload)));
%}

POST {{mas_url}}norsubmit
Content-Type: application/json

{{mas_body2}}

> {%
client.test("HTTP 200", function() {
    client.assert(response.status === 200, "status not 200, actual: " + response.status);
});
client.test("mas rspcod == 'success' && success == true", function() {
    client.assert(response.body.rspcod === "success", "rspcod not success, actual: " + JSON.stringify(response.body));
    client.assert(response.body.success === true, "success not true, actual: " + JSON.stringify(response.body));
});
%}


