# =====================================================================================================================
# 3. 阿里云（aliyun）— POP v1 签名：全参数排序 + RFC3986 编码 + HMAC-SHA1
#    描述文件: channels/aliyun.api.json | 成功判定: $.Code == 'OK'
#    签名与公共参数进 URL 查询串，业务参数进 form body
# =====================================================================================================================

### 阿里云 - SendSms（POP v1 签名）
< {%
// ---- hmac-sha1（纯 JS 实现，与标准库逐字节一致）----
function utf8(s){return encodeURIComponent(s).replace(/%([0-9A-F]{2})/g,function(m,p){return String.fromCharCode(parseInt(p,16))})}
function strToBytes(s){s=utf8(s);var b=[],i;for(i=0;i<s.length;i++)b.push(s.charCodeAt(i));return b}
function sha1bytes(msg){function rotl(v,t){return(v<<t)|(v>>>(32-t))}
var padded=msg.slice(),ml=msg.length;padded.push(0x80);
while(padded.length%64!==56)padded.push(0);
var hi=Math.floor(ml*8/0x100000000),lo=(ml*8)>>>0;
padded.push((hi>>>24)&0xff,(hi>>>16)&0xff,(hi>>>8)&0xff,hi&0xff,(lo>>>24)&0xff,(lo>>>16)&0xff,(lo>>>8)&0xff,lo&0xff);
var H=[0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0],W=new Array(80),off,t;
for(off=0;off<padded.length;off+=64){
for(t=0;t<16;t++)W[t]=(padded[off+t*4]<<24)|(padded[off+t*4+1]<<16)|(padded[off+t*4+2]<<8)|padded[off+t*4+3];
for(t=16;t<80;t++)W[t]=rotl(W[t-3]^W[t-8]^W[t-14]^W[t-16],1);
var a=H[0],b=H[1],c=H[2],d=H[3],e=H[4];
for(t=0;t<80;t++){var f,K;
if(t<20){f=(b&c)^((~b)&d);K=0x5a827999}else if(t<40){f=b^c^d;K=0x6ed9eba1}
else if(t<60){f=(b&c)^(b&d)^(c&d);K=0x8f1bbcdc}else{f=b^c^d;K=0xca62c1d6}
var T=(rotl(a,5)+f+e+K+W[t])|0;e=d;d=c;c=rotl(b,30);b=a;a=T}
H[0]=(H[0]+a)|0;H[1]=(H[1]+b)|0;H[2]=(H[2]+c)|0;H[3]=(H[3]+d)|0;H[4]=(H[4]+e)|0}
var out=[],i;for(i=0;i<5;i++)out.push((H[i]>>>24)&0xff,(H[i]>>>16)&0xff,(H[i]>>>8)&0xff,H[i]&0xff);return out}
function hmacSha1Base64(key,message){
var bkey=strToBytes(key);if(bkey.length>64)bkey=sha1bytes(bkey);
while(bkey.length<64)bkey.push(0);
var inner=sha1bytes(bkey.map(function(k){return k^0x36}).concat(strToBytes(message)));
var bytes=sha1bytes(bkey.map(function(k){return k^0x5c}).concat(inner));
return btoa(String.fromCharCode.apply(null,bytes))}
// 阿里云 percentEncode（RFC3986）
function pe(s){return encodeURIComponent(s).replace(/[!'()*]/g,function(c){return"%"+c.charCodeAt(0).toString(16).toUpperCase()})}

const common = {
  SignatureMethod: "HMAC-SHA1",
  SignatureNonce: Date.now().toString(36) + Math.random().toString(36).slice(2, 10),
  AccessKeyId: "" + request.environment.get("aliyun_ak") + "",
  SignatureVersion: "1.0",
  Timestamp: new Date().toISOString().replace(/\.\d{3}Z$/, "Z"),
  Format: "JSON",
  Action: "SendSms",
  Version: "2017-05-25",
  RegionId: "cn-hangzhou"
};
const biz = {
  PhoneNumbers: "" + request.environment.get("phone") + "",
  SignName: "" + request.environment.get("aliyun_sign") + "",
  TemplateParam: JSON.stringify({ code: "" + request.environment.get("code") + "" }),
  TemplateCode: "" + request.environment.get("aliyun_tpl_code") + ""
};
const all = Object.assign({}, common, biz);
// 全部参数按 key 升序 + RFC3986 编码拼 canonical
const canonical = Object.keys(all).sort().map(function(k){return pe(k)+"="+pe(all[k])}).join("&");
// StringToSign = POST&%2F&percentEncode(canonical)
const stringToSign = "POST&%2F&" + pe(canonical);
// Signature = Base64(HMAC-SHA1(secret + "&", stringToSign))
const signature = hmacSha1Base64("" + request.environment.get("aliyun_sk") + "&", stringToSign);

request.variables.set("ali_sig", pe(signature));
request.variables.set("ali_query", Object.keys(common).sort().map(function(k){return pe(k)+"="+pe(common[k])}).join("&"));
request.variables.set("ali_body", Object.keys(biz).map(function(k){return pe(k)+"="+pe(biz[k])}).join("&"));
%}

POST https://{{aliyun_host}}/?Signature={{ali_sig}}&{{ali_query}}
Content-Type: application/x-www-form-urlencoded

{{ali_body}}


# =====================================================================================================================
# 4. 腾讯云（tencent）— TC3-HMAC-SHA256 四步密钥派生（官方 crypto API）
#    描述文件: channels/tencent.api.json | 成功判定: $.Response.SendStatusSet[0].Code == 'Ok'
#    请求体先在脚本中构造（{{tc_body}}），保证 payload 哈希与实际发送字节完全一致
# =====================================================================================================================

### 腾讯云 - SendSms（TC3 签名）
< {%
const hash = function(s){return crypto.sha256().updateWithText(s).digest().toHex()};
const hmac = function(secret,s){return crypto.hmac.sha256().updateWithText(s).withTextSecret(secret).digest().toHex()};

const ts = Math.floor(Date.now() / 1000).toString();
const date = new Date().toISOString().slice(0, 10);   // UTC 日期 yyyy-MM-dd

const body = JSON.stringify({
  PhoneNumberSet: ["+86" + request.environment.get("phone") + ""],
  SmsSdkAppId: "" + request.environment.get("tencent_sdk_app_id") + "",
  SignName: "" + request.environment.get("tencent_sign") + "",
  TemplateId: "" + request.environment.get("tencent_tpl_id") + "",
  TemplateParamSet: ["" + request.environment.get("code") + ""]
});
request.variables.set("tc_body", body);
request.variables.set("tc_ts", ts);

const canonicalRequest = "POST\n/\n\n"
  + "content-type:application/json; charset=utf-8\n"
  + "host:" + request.environment.get("tencent_host") + "\n\n"
  + "content-type;host\n"
  + hash(body);
const credentialScope = date + "/sms/tc3_request";
const stringToSign = "TC3-HMAC-SHA256\n" + ts + "\n" + credentialScope + "\n" + hash(canonicalRequest);
// 四步密钥派生：TC3+secret -> date -> service -> tc3_request -> 签名
const kDate = hmac("TC3" + request.environment.get("tencent_sk") + "", date);
const kService = hmac(kDate, "sms");
const kSigning = hmac(kService, "tc3_request");
const signature = hmac(kSigning, stringToSign);

request.variables.set("tc_auth",
  "TC3-HMAC-SHA256 Credential=" + request.environment.get("tencent_ak") + "/" + credentialScope
  + ", SignedHeaders=content-type;host, Signature=" + signature);
%}

POST https://{{tencent_host}}
Authorization: {{tc_auth}}
Content-Type: application/json; charset=utf-8
Host: {{tencent_host}}
X-TC-Action: SendSms
X-TC-Timestamp: {{tc_ts}}
X-TC-Version: 2021-01-11
X-TC-Region: ap-guangzhou

{{tc_body}}


