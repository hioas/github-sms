// 引擎实际取前置请求 /service/timestamp 的返回值；此处用本地时间近似（服务端校验有容忍窗口）
const ts = Math.floor(Date.now() / 1000).toString();
const to = "+86" + request.environment.get("phone") + "";
// 签名源按 key 升序：appid, sign_type, sign_version, timestamp, to
const sorted = "appid=" + request.environment.get("submail_appid") + "&sign_type=MD5&sign_version=&timestamp=" + ts + "&to=" + to;
// plain = appid + appkey + 排序串 + "&" + appid + appkey
const plain = "" + request.environment.get("submail_appid") + "" + "" + request.environment.get("submail_appkey") + "" + sorted + "&" + "" + request.environment.get("submail_appid") + "" + "" + request.environment.get("submail_appkey") + "";
request.variables.set("sm_ts", ts);
request.variables.set("sm_sign", md5(plain));
%}

