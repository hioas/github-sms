const mobiles = "" + request.environment.get("phone") + "";
const params = JSON.stringify(["" + request.environment.get("code") + ""]);
const sign = "" + request.environment.get("mas_sign") + "";
const addSerial = "" + request.environment.get("mas_add_serial") + "";
// mac = md5(ecName + apId + secretKey + templateId + mobiles + params + sign + addSerial)
const mac = md5("" + request.environment.get("mas_ec_name") + "" + "" + request.environment.get("mas_ap_id") + "" + "" + request.environment.get("mas_secret") + "" + "" + request.environment.get("mas_tpl_id") + "" + mobiles + params + sign + addSerial);
const payload = JSON.stringify({
  ecName: "" + request.environment.get("mas_ec_name") + "", apId: "" + request.environment.get("mas_ap_id") + "", secretKey: "" + request.environment.get("mas_secret") + "",
  templateId: "" + request.environment.get("mas_tpl_id") + "", mobiles: mobiles, params: params,
  sign: sign, addSerial: addSerial, mac: mac
});
// 整体 JSON 按 UTF-8 字节做 Base64 后作为请求体
request.variables.set("mas_body", btoa(utf8(payload)));
