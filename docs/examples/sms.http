function pad(n){return n<10?"0"+n:""+n}
const d = new Date();   // 引擎按 Asia/Shanghai 时区取时间戳
const ts = pad(d.getMonth()+1) + pad(d.getDate()) + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds());
// pwd = md5(UPPER(userid) + "00000000" + 密码 + MMddHHmmss)
request.variables.set("mw_ts", ts);
request.variables.set("mw_pwd", md5(request.environment.get("montnets_userid").toUpperCase() + "00000000" + request.environment.get("montnets_secret") + ts));
// content：变量 kv 串再做一次 URL 编码（双重编码，与引擎一致）
request.variables.set("mw_content", encodeURIComponent("code=" + encodeURIComponent(request.environment.get("code"))));
%}

POST {{montnets_url}}{{montnets_api}}
Content-Type: application/json;charset=utf-8

{
  "userid": "{{montnets_userid}}",
  "pwd": "{{mw_pwd}}",
  "timestamp": "{{mw_ts}}",
  "mobile": "{{phone}}",
  "content": "{{mw_content}}",
  "tmplid": "{{montnets_tpl_id}}"
}


