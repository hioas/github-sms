# 6. 网易云信（netease）— CheckSum = sha1(secret + nonce + curTime) 放请求头
#    描述文件: channels/netease.api.json | 成功判定: $.code <= 200
# =====================================================================================================================

### 网易云信 - 模板短信（CheckSum 头 + JSON 数组字符串参数）
< {%
// ---- sha1（纯 JS 实现，与标准库逐字节一致）----
function utf8(s){return encodeURIComponent(s).replace(/%([0-9A-F]{2})/g,function(m,p){return String.fromCharCode(parseInt(p,16))})}
function strToBytes(s){s=utf8(s);var b=[],i;for(i=0;i<s.length;i++)b.push(s.charCodeAt(i));return b}
function bytesToHex(b){return b.map(function(x){return(x<16?"0":"")+x.toString(16)}).join("")}
function sha1(s){function rotl(v,t){return(v<<t)|(v>>>(32-t))}
var msg=strToBytes(s),padded=msg.slice(),ml=msg.length;padded.push(0x80);
while(padded.length%64!==56)padded.push(0);
var hi=Math.floor(ml*8/0x100000000),lo=(ml*8)>>>0;
padded.push((hi>>>24)&0xff,(hi>>>16)&0xff,(hi>>>8)&0xff,hi&0xff,(lo>>>24)&0xff,(lo>>>16)&0xff,(lo>>>8)&0xff,lo&0xff);
var H=[0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0],W=new Array(80),off,t;
for(off=0;off<padded.length;off+=64){
for(t=0;t<16;t++)W[t]=(padded[off+t*4]<<24)|(padded[off+t*4+1]<<16)|(padded[off+t*4+2]<<8)|padded[off+t*4+3];
for(t=16;t<80;t++)W[t]=rotl(W[t-3]^W[t-8]^W[t-14]^W[t-16],1);
var a=H[0],b=H[1],c=H[2],d=H[3],e=H[4];
for(t=0;t<80;t++){var f,K;
if(t<20){f=(b&c)^((~b)&d);K=0x5a827999}else if(t<40){f=b^c^d;K=0x6ed9eba1}
else if(t<60){f=(b&c)^(b&d)^(c&d);K=0x8f1bbcdc}else{f=b^c^d;K=0xca62c1d6}
var T=(rotl(a,5)+f+e+K+W[t])|0;e=d;d=c;c=rotl(b,30);b=a;a=T}
H[0]=(H[0]+a)|0;H[1]=(H[1]+b)|0;H[2]=(H[2]+c)|0;H[3]=(H[3]+d)|0;H[4]=(H[4]+e)|0}
var out=[],i;for(i=0;i<5;i++)out.push((H[i]>>>24)&0xff,(H[i]>>>16)&0xff,(H[i]>>>8)&0xff,H[i]&0xff);return out}

const nonce = Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
const curTime = Math.floor(Date.now() / 1000).toString();
request.variables.set("ne_nonce", nonce);
request.variables.set("ne_curtime", curTime);
// CheckSum = sha1(secret + nonce + curTime)
request.variables.set("ne_checksum", bytesToHex(sha1("" + request.environment.get("netease_secret") + "" + nonce + curTime)));
%}

POST {{netease_tpl_url}}
Content-Type: application/x-www-form-urlencoded
AppKey: {{netease_appkey}}
Nonce: {{ne_nonce}}
CurTime: {{ne_curtime}}
CheckSum: {{ne_checksum}}

templateid={{netease_tpl_id}}&mobiles=%5B%22{{phone}}%22%5D&params=%5B%22{{code}}%22%5D&needUp=false


