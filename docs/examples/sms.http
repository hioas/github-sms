return state.map(function(v){var o="",j;for(j=0;j<4;j++)o+=((v>>(j*8+4))&0x0F).toString(16)+((v>>(j*8))&0x0F).toString(16);return o}).join("")}

function pad(n){return n<10?"0"+n:""+n}
const d = new Date();   // 引擎按 Asia/Shanghai 时区取时间戳
const ts = "" + d.getFullYear() + pad(d.getMonth()+1) + pad(d.getDate()) + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds());
// sign = md5(appId + secretKey + 时间戳)
request.variables.set("em_ts", ts);
request.variables.set("em_sign", md5("" + request.environment.get("emay_app_id") + "" + "" + request.environment.get("emay_secret") + "" + ts));
request.variables.set("em_content", encodeURIComponent("" + request.environment.get("emay_message") + ""));
%}

